# Environment variables read by the Vanmool services.
# Each service runs as its own process (IntelliJ run configuration, Docker container, AWS environment)
# with its own values for these variables, so the same names can be used by every service.
# In IntelliJ, set them under Run/Debug Configurations > Environment variables. .env is git-ignored.

# product-service (port 8080)
DB_URL=jdbc:mysql://localhost:3306/product_db
DB_USERNAME=your_mysql_user
DB_PASSWORD=your_mysql_password
# Redis for the product cache (docker compose up -d redis); a password only if the server requires one
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Longest time a product stays cached, as an ISO-8601 duration
PRODUCT_CACHE_TTL=PT10M
# Kafka broker(s): product-service reads order-events
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Product and stock changes need a seller's or admin's token: issuer, and where its public keys are (a service name,
# found through Eureka)
AUTH_ISSUER=http://localhost:8081
AUTH_JWKS_URI=http://user-auth-service/oauth2/jwks

# user-auth-service (port 8081)
DB_URL=jdbc:mysql://localhost:3306/user_db
DB_USERNAME=your_mysql_user
DB_PASSWORD=your_mysql_password
# RSA private key (PKCS#8 PEM, or its Base64 on one line) that signs tokens, e.g. from:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
JWT_PRIVATE_KEY=your_pkcs8_rsa_private_key
# Public URL of this service, written into tokens as their issuer
AUTH_ISSUER=http://localhost:8081
# Start of the emailed password reset link; the token is appended. Default: this service's own page
PASSWORD_RESET_LINK=http://localhost:8081/auth/password-reset/confirm?token=
# Kafka broker(s), for the events this service publishes
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# cart-service (port 8082)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Tokens are checked against the issuer and public keys of user-auth-service
AUTH_ISSUER=http://localhost:8081
AUTH_JWKS_URI=http://user-auth-service/oauth2/jwks
# Calls to product-service go to its name, through Eureka
PRODUCT_SERVICE_URL=http://product-service
# A cart untouched for this long is deleted, as an ISO-8601 duration
CART_TTL=P30D

# order-service (port 8083)
DB_URL=jdbc:mysql://localhost:3306/order_db
DB_USERNAME=your_mysql_user
DB_PASSWORD=your_mysql_password
AUTH_ISSUER=http://localhost:8081
AUTH_JWKS_URI=http://user-auth-service/oauth2/jwks
CART_SERVICE_URL=http://cart-service
PRODUCT_SERVICE_URL=http://product-service
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Unpaid orders are cancelled after this long (ISO-8601 duration)
ORDER_PAYMENT_WINDOW=PT60M

# notification-service (no HTTP port)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# SMTP: Mailpit locally (docker compose up -d mailpit); for a real service such as Amazon SES set the login and
# MAIL_SMTP_AUTH=true, MAIL_SMTP_STARTTLS=true
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=Vanmool <orders@vanmool.example>
REDIS_HOST=localhost
REDIS_PORT=6379

# payment-service (port 8085)
DB_URL=jdbc:mysql://localhost:3306/payment_db
DB_USERNAME=your_mysql_user
DB_PASSWORD=your_mysql_password
ORDER_SERVICE_URL=http://order-service
AUTH_ISSUER=http://localhost:8081
AUTH_JWKS_URI=http://user-auth-service/oauth2/jwks
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Public address for gateway callbacks and webhooks (a tunnel's URL for webhooks during development)
PAYMENT_PUBLIC_BASE_URL=http://localhost:8085
PAYMENT_DEFAULT_GATEWAY=RAZORPAY
# Test mode keys only (rzp_test_..., sk_test_...); a gateway without keys is switched off
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Development only: a fake gateway whose checkout page marks payments paid without money
PAYMENT_FAKE_GATEWAY_ENABLED=false

# Any service: SERVER_PORT overrides the default port, for example inside a container
# SERVER_PORT=8080

# service-discovery (port 8761, the Eureka registry)
# Off locally: with a few instances, self-preservation mostly keeps instances that were just stopped
EUREKA_SELF_PRESERVATION=false

# Every HTTP service (product, user-auth, cart, order, payment) registers here
EUREKA_URL=http://localhost:8761/eureka/

# api-gateway (port 8000, the address clients use)
# Redis holds the rate limit counters for signing in (10 a minute per client address) and the ended tokens
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Kafka: the gateway reads user-events (TokenRevoked)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
